# Copy to `.env` (local) and set the same keys in Vercel.

# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# AI — prefer Claude; without any key, briefing falls back to rules (fail-soft)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Or use Vercel AI Gateway:
# AI_GATEWAY_API_KEY=""

# Auth stub cookie secret (min 16 chars)
AUTH_SECRET="statuspro-dev-secret-change-me"

# Feature flags (comma-separated enabled flags)
FEATURE_FLAGS="ai_briefing,ai_chat,sync_center,playbooks"

# App
NEXT_PUBLIC_APP_NAME="StatusPro"
NEXT_PUBLIC_DEFAULT_ORG_SLUG="distribuidora-demo"
