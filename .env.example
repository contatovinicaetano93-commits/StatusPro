# Copy to `.env` (local) and set the same keys in Vercel.

# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Required in production (min 16 chars, not the dev default)
AUTH_SECRET="change-me-to-a-long-random-string"

# Demo login (ceo@… / demo). In production must be explicitly true.
ALLOW_DEMO_AUTH="true"

# AI — prefer Claude; without any key, briefing falls back to rules (fail-soft)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Or use Vercel AI Gateway:
# AI_GATEWAY_API_KEY=""

# ERP: mock | fkn
ERP_MODE="mock"
# Required when ERP_MODE=fkn (ask suporte FKN for real values)
ERP_FKN_BASE_URL=""
ERP_FKN_API_KEY=""
# Optional path overrides once docs arrive
ERP_FKN_HEALTH_PATH="/health"
ERP_FKN_PULL_PATH="/api/v1/pull"
ERP_FKN_TIMEOUT_MS="30000"

# Feature flags (comma-separated enabled flags)
FEATURE_FLAGS="ai_briefing,ai_chat,sync_center,playbooks"

# App
NEXT_PUBLIC_APP_NAME="StatusPro"
